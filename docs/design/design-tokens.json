{
  "meta": { "name": "频率 · 暖沙静谧", "mode": "light-primary", "version": "0.1.0" },
  "color": {
    "bg": "#F5F1E8",
    "bgDeep": "#1F1B2E",
    "surface": "#FBF8F1",
    "surfaceDeep": "#2A2440",
    "textPrimary": "#2A2622",
    "textSecondary": "#8A8378",
    "textInverse": "#F5F1E8",
    "accent": "#C97B5A",
    "accentSoft": "#EDD9C8",
    "presence": "#6E8B96",
    "presenceSoft": "#D8E3E6",
    "success": "#7C9473",
    "danger": "#B5493A",
    "hairline": "rgba(42,38,34,0.08)"
  },
  "colorDark": {
    "bg": "#1F1B2E",
    "surface": "#2A2440",
    "textPrimary": "#F5F1E8",
    "textSecondary": "rgba(245,241,232,0.55)",
    "textTertiary": "rgba(245,241,232,0.35)",
    "accent": "#D9916D",
    "accentSoft": "rgba(201,123,90,0.22)",
    "presence": "#86A5AF",
    "hairline": "rgba(245,241,232,0.12)",
    "note": "深色下强调色由 #C97B5A 提亮/降饱和为 #D9916D 以维持对比度，并常配 radial-gradient 柔光而非纯色块"
  },
  "font": {
    "serif": "Fraunces, 'Noto Serif SC', serif",
    "sans": "Inter, 'Noto Sans SC', sans-serif"
  },
  "type": {
    "display": { "size": 40, "lineHeight": 44, "weight": 500, "font": "serif" },
    "title": { "size": 28, "lineHeight": 36, "weight": 500, "font": "serif" },
    "heading": { "size": 20, "lineHeight": 28, "weight": 600, "font": "sans" },
    "body": { "size": 17, "lineHeight": 28, "weight": 400, "font": "sans" },
    "caption": { "size": 14, "lineHeight": 20, "weight": 400, "font": "sans" }
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "radius": { "sm": 12, "md": 20, "lg": 28, "pill": 999 },
  "shadow": {
    "soft": "0 8px 24px rgba(42,38,34,0.08)",
    "card": "0 12px 40px rgba(42,38,34,0.07)",
    "accentGlow": "0 10px 24px rgba(201,123,90,0.35)",
    "popover": "0 14px 34px rgba(42,38,34,0.14)",
    "popoverDark": "0 14px 34px rgba(0,0,0,0.4)",
    "toast": "0 8px 20px rgba(42,38,34,0.2)"
  },
  "component": {
    "messageActionPopover": {
      "surface": "#FBF8F1",
      "surfaceDark": "#342C4E",
      "radius": 18,
      "itemRadius": 12,
      "enterMs": 240,
      "enterFrom": "scale(0.9) opacity(0)",
      "anchor": "message top-left, scales out from message edge (not screen edge)"
    },
    "toast": {
      "bg": "#2A2622",
      "bgDark": "#F5F1E8",
      "text": "#F5F1E8",
      "textDark": "#1F1B2E",
      "radius": 999,
      "durationMs": 1500
    },
    "swipeDelete": {
      "revealBg": "#EAD9CC",
      "revealBgDark": "#3A2C33",
      "confirmLabel": "放下",
      "cancelLabel": "留着",
      "collapseMs": 300
    },
    "coachMessage": {
      "coachBubbleBg": "#FBF8F1",
      "coachBubbleBgDark": "#2A2440",
      "coachTextColor": "textPrimary",
      "userBubbleBg": "#F3E4D6",
      "userBubbleBgDark": "rgba(201,123,90,0.16)",
      "userTextColor": "#4A3B30 (light) / #F1DFCE (dark)",
      "bubbleRadius": "20px, direction corner reduced to 6px (soft speech direction without a tail)",
      "bubbleMaxWidth": "78%",
      "bubblePadding": "16px 18px",
      "bubbleLineHeight": 1.75,
      "groupGapSameSpeaker": 6,
      "groupGapSpeakerChange": 20,
      "avatar": {
        "size": 34,
        "style": "layered radial-gradient halo (breath/light motif) + thin inner ring — not a flat color circle",
        "gradientLight": "radial-gradient(circle at 35% 30%, #F3D9C4, #D8E3E6 65%, #C9A98A 100%)",
        "gradientDark": "radial-gradient(circle at 35% 30%, #6E5A78, #3A3560 65%, #2A2440 100%)",
        "showRule": "only on the first bubble of a consecutive coach run, not on every message",
        "userAvatar": "none — right alignment + warm bubble wash already distinguish the user; an avatar would add visual noise for a side that never needs identification"
      }
    }
  },
  "motion": {
    "easing": "ease-in-out",
    "durationMs": [300, 600],
    "breatheCycleMs": 5000,
    "notes": "无弹跳曲线；步骤切换用淡入+8px位移；完成态用柔光扩散2-3s后收束"
  }
}
